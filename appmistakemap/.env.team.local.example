# Contas da equipe para rodar o app em modo de desenvolvimento.
# Copie para .env.team.local (ignorado pelo Git) e preencha no seu computador.
# Uso: flutter run --dart-define-from-file=.env.team.local
# Em build de release os atalhos não aparecem, mesmo com este arquivo.

# Conta de desenvolvimento/teste (entra direto com e-mail e senha).
MISTAKEMAP_TEST_EMAIL=
MISTAKEMAP_TEST_PASSWORD=

# Conta de admin. Recomendado: deixe a senha vazia; o atalho só preenche o
# e-mail e você digita a senha. O papel admin é conferido no banco.
MISTAKEMAP_ADMIN_EMAIL=
MISTAKEMAP_ADMIN_PASSWORD=
